{
  "name": "navis",
  "version": "0.1.0",
  "description": "navis — namory 기반 양방향 에이전트 (앱 백엔드 HTTP 서버 + CLI)",
  "type": "module",
  "bin": {
    "navis": "./dist/cli.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && chmod +x dist/cli.js",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.tsx"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.152",
    "@googleapis/calendar": "^14.3.0",
    "google-auth-library": "^10.6.2",
    "ink": "^7.0.4",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.7",
    "marked-terminal": "^7.3.0",
    "node-cron": "^3.0.3",
    "react": "^19.2.6",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "google-auth-library": "$google-auth-library"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
