# Claude Code 구독 OAuth 토큰. 로컬에서 `claude setup-token` 으로 발급.
# (일반 ANTHROPIC_API_KEY 아님 — 구독 한도 안에서 쓰는 토큰)
CLAUDE_CODE_OAUTH_TOKEN=

# namory MCP 서버 주소. 로컬 테스트: http://localhost:3000/mcp
# Railway 내부망: http://namory.railway.internal:<namory포트>/mcp
NAMORY_MCP_URL=http://localhost:3000/mcp

# namory 엔드포인트 토큰 (namory 서비스의 NAMORY_TOKEN과 같은 값)
NAMORY_TOKEN=

# 구글 캘린더 OAuth (셋 다 채워야 활성).
# 발급:
#   1) Google Cloud Console 새 프로젝트 → Calendar API 사용 설정
#   2) OAuth 동의 화면(테스트 모드) + 본인 이메일을 테스트 사용자로 추가
#   3) 사용자 인증 정보 → OAuth 2.0 클라이언트(웹 애플리케이션) 발급
#      승인된 리디렉션 URI: https://developers.google.com/oauthplayground
#   4) OAuth Playground 에서 Use your own OAuth credentials 체크 후 client id/secret 입력
#      → scope https://www.googleapis.com/auth/calendar 선택 → Authorize
#      → Exchange authorization code for tokens → refresh_token 복사
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 자기 소스 조회용 GitHub 레포 (owner/repo). 호스팅 컨테이너엔 src/가 없어서
# read_repo_file/list_repo_files 가 이 레포의 GitHub Contents API 를 읽는다.
GITHUB_REPO=nu-tree/navis
# 선택: GitHub 토큰. private 레포면 필수, public 이어도 있으면 rate limit 60→5000/h.
# fine-grained PAT 권장 — 자기 조회만 할 거면 Contents:Read 만.
# 자기 개선(self-improve) 트리거까지 쓰려면 Actions:Write 도 추가.
GITHUB_TOKEN=

# self-improve PR 생성 webhook 검증용 HMAC secret.
# GitHub repo Settings → Webhooks 등록 시 같은 값을 secret 에 박는다.
# 미설정이면 navis 의 /webhook/github 라우트가 모든 요청을 거부.
GITHUB_WEBHOOK_SECRET=

# 모바일/데스크톱 앱(navis-app)의 /api/chat 호출 인증 토큰.
# 긴 랜덤 문자열(예: `openssl rand -hex 32`). 미설정이면 /api/chat 비활성(503).
# 앱의 EXPO_PUBLIC_NAVIS_TOKEN 과 반드시 같은 값이어야 한다.
APP_API_TOKEN=

# 데스크톱 설치파일(.dmg/.exe + latest*.yml)을 보관/서빙할 디렉터리.
# Railway 볼륨 마운트 경로를 넣는다(예: /data/desktop). 재배포에도 유지되려면
# 반드시 볼륨이어야 한다. 미설정이면 임시 디스크(.desktop-dist)라 재배포 시 사라짐.
# 다운로드 페이지/업로드/자동업데이트 인증은 위 APP_API_TOKEN 을 그대로 쓴다.
DESKTOP_DIR=/data/desktop

# 선택: ntfy 푸시(모바일 알림). 설정 시 모든 선제 보고(작업완료/크론/다이제스트)를
# 폰의 ntfy 앱으로 푸시한다 — 무료 Apple 계정이라 navis-app 자체 APNs 가 안 되는 대신.
# NTFY_TOPIC: 추측 불가한 랜덤 문자열(공개 ntfy.sh 는 토픽명을 아는 사람이 구독 가능 →
#   랜덤명이 사실상의 접근 제어). 폰에서 ntfy 앱 설치 후 같은 토픽을 구독하면 끝.
# NTFY_URL: 미설정 시 공개 인스턴스(https://ntfy.sh). 자체호스팅 시에만 바꾼다.
NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh

# 헬스체크 포트 (Railway가 자동 주입)
PORT=3000

# 동적 MCP 커넥터 OAuth 용 공개 URL(예: https://navis.up.railway.app).
# redirect_uri = 이 값 + /api/connectors/oauth/callback 로 만들어지며,
# 각 제공자(OAuth 앱)에 등록한 콜백과 정확히 같아야 한다. 미설정이면 OAuth 시작이 에러
# (정적 키 커넥터는 영향 없음).
NAVIS_PUBLIC_URL=

# 커넥터 OAuth 제공자별 client 자격 — <KEY>_OAUTH_CLIENT_ID / _SECRET 규약.
# 예: Notion 공개 인테그레이션(OAuth)을 만들고 redirect_uri 를 위 콜백으로 등록.
# 둘 다 미설정이면 앱 커넥터 화면에서 해당 제공자가 "미설정"으로 비활성 표시된다.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# 봇 성격·행동 지침 (필수). 코드에 두지 않고 여기/Railway 변수로만 주입 — 레포 공개 대비.
# 멀티라인 + 내부 따옴표(' ")가 섞이므로 백틱(`)으로 감싼다(Node --env-file이 백틱 지원).
# Railway에선 변수 값에 멀티라인 그대로 붙여넣으면 됨(백틱 불필요).
# SYSTEM_PROMPT=`당신은 사용자 전용 비서 '나비스(navis)'이며 ...
# ... 여러 줄 ...`
