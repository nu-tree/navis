{
  "expo": {
    "name": "나비스",
    "slug": "navis",
    "scheme": "navis",
    "version": "0.1.3",
    "orientation": "portrait",
    "icon": "./assets/navis-logo.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/e6b968a5-0016-4cce-b55a-babc17f9b2fd",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.knu9910.navis"
    },
    "android": {
      "package": "com.navis.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/navis-logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "나비스에게 보낼 이미지를 선택하기 위해 사진 접근 권한이 필요해요."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e6b968a5-0016-4cce-b55a-babc17f9b2fd"
      }
    }
  }
}
