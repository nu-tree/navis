{
  "name": "namory-monorepo",
  "version": "0.0.0",
  "description": "namory — 제2의 뇌 (기억 라이브러리) + navis 에이전트 + 웹/앱 클라이언트",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter namory db:generate",
    "db:migrate": "pnpm --filter namory db:migrate",
    "ota": "cd packages/app && eas update --branch preview"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.8"
}
