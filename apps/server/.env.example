# Supabase Postgres. 풀러(transaction mode, 6543) URL 권장.
DATABASE_URL=

# Voyage AI 임베딩 (기억 벡터 검색).
# 반드시 1024차원을 내는 모델을 쓴다 — schema.ts 가 vector(1024) 로 고정되어 있어
# 차원이 다르면 삽입이 실패한다. 없으면 서버가 부팅되지 않는다.
VOYAGE_API_KEY=

# 설정 암호화 키(32바이트 base64) — `openssl rand -base64 32`. 없으면 서버가 부팅되지 않는다.
# Claude 구독 토큰은 환경변수로 넣지 않는다. 웹의 설정 화면에서 등록하면 이 키로 암호화해
# DB 에 저장한다(US5). 키를 바꾸면 저장된 토큰을 풀 수 없으니 다시 등록해야 한다.
NAVIS_SETTINGS_KEY=

# 이 서버를 부를 클라이언트(apps/web 의 서버 사이드, apps/mobile)의 Bearer 토큰.
# `openssl rand -hex 32`. 브라우저에 노출되지 않는다 — web 은 BFF 로 중계한다.
API_TOKEN=

# (선택) 관리자의 외부 MCP Bearer 토큰. API_TOKEN 과 **다른 값**으로 `openssl rand -hex 32`.
# 회원은 웹 설정 → "AI 앱에 연결"에서 자기 연결을 만든다 — 이 값은 예전부터 쓰던 관리자 연결용이다.
# 비워둬도 /mcp 는 열린다.
NAVIS_MCP_TOKEN=

# Cloud Scheduler 가 /internal/tick 을 부를 때 쓰는 토큰(약속 실행, specs/003).
# API_TOKEN · NAVIS_MCP_TOKEN 과 **다른 값**으로 `openssl rand -hex 32`. 비워두면 tick 이 닫힌다(404) —
# 약속이 실행되지 않을 뿐 대화는 된다.
NAVIS_TICK_TOKEN=

# 관리자(Owner) 회원 uuid — Supabase 대시보드 → Authentication → Users 의 UID.
# 외부 MCP(Claude Code)로 들어오는 기억과 다중 사용자 전환 전의 기존 데이터가 이 회원의 것이다.
# 없거나 uuid 가 아니면 서버가 부팅되지 않는다.
# 이 회원만 다른 회원에게 말을 걸 수 있다(전하기, specs/004) — 새 환경변수는 없고, 전하기 턴은 이 회원의
# Claude 토큰으로 돈다. 받는 사람 목록은 같은 DB 의 auth.users 에서 읽는다(로컬 docker DB 에는 없어 uuid 로 대신).
NAVIS_OWNER_ID=

# 웹 푸시(창을 닫아도 오는 답 도착 알림). `npx web-push generate-vapid-keys` 로 한 쌍을 만든다.
# 비워두면 푸시만 꺼진다 — 화면 알림(창이 열려 있을 때)은 그대로다.
NAVIS_VAPID_PUBLIC_KEY=
NAVIS_VAPID_PRIVATE_KEY=
# 푸시 서비스가 연락할 곳. mailto: 나 https: (애플은 localhost 를 거부한다)
NAVIS_VAPID_SUBJECT=

PORT=4000
