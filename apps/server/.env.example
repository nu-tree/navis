# Supabase Postgres. 풀러(transaction mode, 6543) URL 권장.
DATABASE_URL=

# Voyage AI 임베딩 (기억 벡터 검색)
VOYAGE_API_KEY=

# Claude Code 구독 OAuth 토큰. `claude setup-token` 으로 발급.
CLAUDE_CODE_OAUTH_TOKEN=

# 이 서버를 부를 클라이언트(apps/web 의 서버 사이드, apps/mobile)의 Bearer 토큰.
# `openssl rand -hex 32`. 브라우저에 노출되지 않는다 — web 은 BFF 로 중계한다.
API_TOKEN=

PORT=4000
