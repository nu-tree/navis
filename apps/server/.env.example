# Supabase Postgres. 풀러(transaction mode, 6543) URL 권장.
DATABASE_URL=

# Voyage AI 임베딩 (기억 벡터 검색).
# 반드시 1024차원을 내는 모델을 쓴다 — schema.ts 가 vector(1024) 로 고정되어 있어
# 차원이 다르면 삽입이 실패한다. 없으면 서버가 부팅되지 않는다.
VOYAGE_API_KEY=

# 설정 암호화 키(32바이트 base64) — `openssl rand -base64 32`. 없으면 서버가 부팅되지 않는다.
# Claude 구독 토큰은 환경변수로 넣지 않는다. 웹의 설정 화면에서 등록하면 이 키로 암호화해
# DB 에 저장한다(US5). 키를 바꾸면 저장된 토큰을 풀 수 없으니 다시 등록해야 한다.
NAVIS_SETTINGS_KEY=

# 이 서버를 부를 클라이언트(apps/web 의 서버 사이드, apps/mobile)의 Bearer 토큰.
# `openssl rand -hex 32`. 브라우저에 노출되지 않는다 — web 은 BFF 로 중계한다.
API_TOKEN=

# 외부 MCP(Claude Code 연결)의 Bearer 토큰. API_TOKEN 과 **다른 값**으로 `openssl rand -hex 32`.
# 비워두면 /mcp 가 닫힌다(404).
NAVIS_MCP_TOKEN=

PORT=4000
