{
  "name": "@navis/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/index.js --external:@anthropic-ai/claude-agent-sdk \"--banner:js=import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@hono/node-server": "^2.1.1",
    "@navis/db": "workspace:*",
    "@navis/domain": "workspace:*",
    "@navis/validation": "workspace:*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@navis/config": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
